# Non-content, tooling and private paths - kept out of search results without naming them in robots.txt. They are already 404'd in _redirects; these headers are defense-in-depth if a redirect rule is ever dropped.
/netlify/*
  X-Robots-Tag: noindex, nofollow
/_includes/*
  X-Robots-Tag: noindex, nofollow
/tests/*
  X-Robots-Tag: noindex, nofollow
/cypress/*
  X-Robots-Tag: noindex, nofollow
/reports/*
  X-Robots-Tag: noindex, nofollow
/logs/*
  X-Robots-Tag: noindex, nofollow
/docs/*
  X-Robots-Tag: noindex, nofollow
/articles/*
  X-Robots-Tag: noindex, nofollow
/projects/*
  X-Robots-Tag: noindex, nofollow

# Public assets under the otherwise-blocked /docs tree stay indexable (longer path wins for a conflicting header).
/docs/public/*
  X-Robots-Tag: all
