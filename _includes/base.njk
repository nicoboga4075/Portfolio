---
base: "../../"
onload: "initPage()"
image: "https://nicoboga.netlify.app/images/view.png"
bodyClass: ""
---
{%- set minimal = not synopsis and not bingo -%}
{%- set parts = page.fileSlug.split("_") -%}
{%- set suffix = parts[parts.length - 1] -%}
{%- set lang = suffix if suffix.length == 2 else languages.default -%}
{%- set loadingText = { en: "Loading…", fr: "Chargement…" } -%}
{%- set landmarkLabels = {
    en: { visitor: "Visitor count", nav: "Main navigation", main: "Main content", footer: "Site footer" },
    fr: { visitor: "Nombre de visiteurs", nav: "Navigation principale", main: "Contenu principal", footer: "Pied de page" }
} -%}
{%- set ll = landmarkLabels[lang] -%}
{%- set contactTitle = { en: "Contact me", fr: "Me contacter" } -%}
{%- set closeLabel = { en: "Close", fr: "Fermer" } -%}
{%- set articles = [
    { slug: "bien-pasbien", title: { en: "Good / Not Good: good and bad coding practices", fr: "Bien / Pas Bien : bonnes et mauvaises pratiques de code" }, date: "2025-07-26", tags: [
        "Clean Code", "SOLID", { "Design Patterns": "https://refactoring.guru/design-patterns" }, "DRY", "KISS", "C#", "Python", "JavaScript"
    ] },
    { slug: "du-voc-de-dev", title: { en: "From the dev vocab", fr: "Du voc' de dev" }, date: "2025-05-05", tags: [
        "Framework", "Library", "Package", "Module"
    ] },
    { slug: "mcs", title: { en: "What is a MSC application ?", fr: "Une application MCS : Kézako ?" }, date: "2024-12-23", tags: [
        { "MCS": "https://gimelec.fr/wp-content/uploads/2025/03/GIMELEC-Cyber-OT-Livre-blanc-MCS-2025-web.pdf" },
        { "CyberSecurity": "https://cyber.gouv.fr/le-cyberdico" },
        { "Vulnerability": "https://www.cvedetails.com/vulnerability-list" },
        "REST",
        { "API": "https://aws.amazon.com/fr/what-is/api" },
        { "OAuth2": "https://loan-truong.medium.com/le-protocole-oauth2-0-a845773bec21" }
    ] },
    { slug: "presentation", title: { en: "My career in few lines", fr: "Mon parcours pro en quelques lignes" }, date: "2024-01-01", tags: [
        { "Software Engineer": "https://blog.lewagon.com/fr/career/metier-software-engineer" },
        { "Full Stack Developer": "https://blog.lewagon.com/fr/career/metiers-tech-developpement-web-developpeur-full-stack" },
        "Paris", "Lyon",
        { "ESILV": "https://www.esilv.fr/ingenieur/classement" },
        { "UQAC": "https://www.uqac.ca/programme/3037-maitrise-en-informatique-professionnel" }
    ] },
    { slug: "sur-quels-criteres-choisir-une-agence-web", title: { en: "How to choose a web agency ?", fr: "Sur quels critères choisir une agence web ?" }, date: "2019-07-31", tags: [
        "Web Agency", "Digital Transformation", "Project Management", "Business Growth"
    ] },
    { slug: "5-conseils-pour-un-nom-de-marque-parfait", title: { en: "5 tips for the perfect brand name", fr: "5 conseils pour un nom de marque parfait" }, date: "2019-07-03", tags: [
        "Brand Naming", "Business Growth", "Trademark", "Entrepreneurship"
    ] }
] -%}
{%- set appArticlesData = articles | resolveArticles(lang) -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
    <head>
        <meta charset="utf-8">
        <title>{{ title | safe }}</title>
        <meta name="google" content="notranslate">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="author" content="{{ author }}">
        <meta name="theme-color" content="#ffffff">
        <meta name="title" property="og:title" content="{{ title | safe }}">
        <meta name="image" property="og:image" content="{{ image }}">
        <meta name="description" content="{{ description | safe }}">
        {%- if noindex %}
        <meta name="robots" content="noindex">
        {%- endif %}
        {%- if assets and "head-scripts.html" in assets %}
        <meta name="app-articles" content="{{ appArticlesData | dump }}">
        {%- endif %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">
        <base href="{{ base }}">
        <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="favicon-16x16.png">
        <link rel="manifest" href="site.webmanifest">
        {%- if assets %}
        {%- for partial in assets %}
        {% include partial %}
        {%- endfor %}
        {%- else %}
        <link rel="stylesheet" href="css/common.css">
        <link rel="stylesheet" href="css/default.css">
        <script src="js/common.js" defer></script>
        <script src="js/default.js" defer></script>
        {%- endif %}
        {%- if botpress and viewport == "desktop" %}
        <script defer src="js/botpress.js"></script>
        {%- endif %}
        {%- if profile %}
        <script src="https://platform.linkedin.com/badges/js/profile.js" async defer></script>
        {%- endif %}
    </head>
    <body class="{{ bodyClass }}"{% if scrollspy %} data-spy="scroll" data-target="#ftco-navbar" data-offset="300"{% endif %} onload="{{ onload }}">
        <div id="ftco-loader" class="show fullscreen" role="status" aria-live="polite" aria-atomic="true" aria-label="{{ loadingText[lang] }}">
            <div class="spinner" aria-hidden="true"></div>
            <span class="sr-only">{{ loadingText[lang] }}</span>
        </div>
        <div id="ftco-visitor" hidden aria-label="{{ ll.visitor }}"></div>
        {%- if contact %}
        <div id="contact-icon" class="open-mfp d-flex justify-content-center text-white" data-target="#contact-window" aria-expanded="false" aria-controls="contact-window" aria-label="{{ contactTitle[lang] }}">
            <span class="icon-user" aria-hidden="true"></span>
        </div>
        <div id="contact-window" class="mfp flex-column bg-white" hidden>
            <div id="contact-header" class="d-flex align-items-center justify-content-between text-white">
                <h6>{{ contactTitle[lang] }}</h6>
                <span class="mfp-close" aria-label="{{ closeLabel[lang] }}">×</span>
            </div>
            <div id="contact-link" class="text-dark">
                <p class="d-flex align-items-center">
                    <i class="icon-envelope"></i>
                    <span class="email"></span>
                </p>
                {%- for s in socials %}
                <p class="d-flex align-items-center">
                    <i class="icon-{{ s.modalIcon or s.icon }}"></i>
                    <a target="_blank" rel="noopener" href="{{ s.href }}" aria-label="{{ s.label }}">{{ s.label }}</a>
                </p>
                {%- endfor %}
            </div>
        </div>
        {%- endif %}
        {%- if nav %}
        <nav id="ftco-navbar" class="navbar navbar-expand-lg navbar-dark ftco-navbar-light" aria-label="{{ ll.nav }}">
            {% include "nav.html" %}
        </nav>
        {%- endif %}
        <main id="ftco-main" aria-label="{{ ll.main }}">
            {{ content | safe }}
        </main>
        <footer id="ftco-footer"{% if minimal %} class="minimal"{% endif %} aria-label="{{ ll.footer }}">
            {% include "footer.html" %}
        </footer>
    </body>
</html>
