---
base: "../../"
onload: "initPage()"
image: "https://nicoboga.netlify.app/images/view.png"
bodyClass: ""
---
{%- set parts = page.fileSlug.split("_") -%}
{%- set suffix = parts[parts.length - 1] -%}
{%- set lang = suffix if suffix.length == 2 else languages.default -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
    <head>
        <meta charset="utf-8">
        <title>{{ title | safe }}</title>
        <meta name="google" content="notranslate">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="author" content="{{ author }}">
        <meta name="theme-color" content="#ffffff">
        <meta name="title" property="og:title" content="{{ title | safe }}">
        <meta name="image" property="og:image" content="{{ image }}">
        <meta name="description" content="{{ description | safe }}">
        {%- if noindex %}
        <meta name="robots" content="noindex">
        {%- endif %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">
        <base href="{{ base }}">
        <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="favicon-16x16.png">
        <link rel="manifest" href="site.webmanifest">
        {%- if assets %}
        {%- for partial in assets %}
        {% include partial %}
        {%- endfor %}
        {%- else %}
        <link rel="stylesheet" href="css/common.css">
        <link rel="stylesheet" href="css/default.css">
        <script src="js/common.js" defer></script>
        <script src="js/default.js" defer></script>
        {%- endif %}
        {%- if botpress and viewport == "desktop" %}
        <script defer src="js/botpress.js"></script>
        {%- endif %}
        {%- if profile %}
        <script src="https://platform.linkedin.com/badges/js/profile.js" async defer></script>
        {%- endif %}
    </head>
    <body class="{{ bodyClass }}"{% if scrollspy %} data-spy="scroll" data-target="#ftco-navbar" data-offset="300"{% endif %} onload="{{ onload }}">
        {%- set loadingText = { en: "Loading…", fr: "Chargement…" } -%}
        {%- set landmarkLabels = {
            en: { visitor: "Visitor count", nav: "Main navigation", main: "Main content", footer: "Site footer" },
            fr: { visitor: "Nombre de visiteurs", nav: "Navigation principale", main: "Contenu principal", footer: "Pied de page" }
        } -%}
        {%- set ll = landmarkLabels[lang] -%}
        <div id="ftco-loader" class="show fullscreen" role="status" aria-live="polite" aria-atomic="true" aria-label="{{ loadingText[lang] }}">
            <div class="spinner" aria-hidden="true"></div>
            <span class="sr-only">{{ loadingText[lang] }}</span>
        </div>
        <div id="ftco-visitor" hidden aria-label="{{ ll.visitor }}"></div>
        {%- if nav %}
        <nav id="ftco-navbar" class="navbar navbar-expand-lg navbar-dark ftco-navbar-light" aria-label="{{ ll.nav }}">
            {% include "nav.html" %}
        </nav>
        {%- endif %}
        <main id="ftco-main" aria-label="{{ ll.main }}">
        {{ content | safe }}
        </main>
        {%- if contact %}
        {% include "contact.html" %}
        {%- endif %}
        <footer id="ftco-footer" aria-label="{{ ll.footer }}">
            {% include "footer.html" %}
        </footer>
    </body>
</html>
