---
base: "../../"
onload: "initPage()"
image: "https://nicoboga.netlify.app/images/view.png"
bodyClass: ""
---
{%- set standalone = not synopsis and not bingo -%}
{%- set parts = page.fileSlug.split("_") -%}
{%- set suffix = parts[parts.length - 1] -%}
{%- set lang = suffix if suffix.length == 2 else siteLanguages.default -%}
{%- set landmarkLang = common.landmark[lang] -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
    <head>
        <meta charset="utf-8">
        <title>{{ title | safe }}</title>
        <meta name="google" content="notranslate">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="author" content="{{ author }}">
        <meta name="title" property="og:title" content="{{ title | safe }}">
        <meta name="image" property="og:image" content="{{ image }}">
        <meta name="description" content="{{ description | safe }}">
        {%- if assets and "head-scripts.html" in assets %}
        <meta name="articles" content="{{ articles | resolveArticles(lang, siteLanguages.default, siteLanguages.locales) | dump }}">
        <meta name="i18n-messages" content="{{ messages | dump }}">
        {%- endif %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
        <base href="{{ base }}">
        <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="favicon-16x16.png">
        <link rel="manifest" href="site.webmanifest">
        {%- if assets %}
        {%- for partial in assets %}
        {% include partial %}
        {%- endfor %}
        {%- else %}
        <link rel="stylesheet" href="css/common.css">
        <link rel="stylesheet" href="css/standalone.css">
        <script src="js/common.js" defer></script>
        <script src="js/standalone.js" defer></script>
        {%- endif %}
        {%- if botpress and viewport == "desktop" %}
        <script defer src="js/botpress.js"></script>
        {%- endif %}
        <!-- Inline, after the stylesheets and before first paint: the deferred common.js applies the theme too late (white flash in dark mode). It waits for the CSS above, so --background is already resolved. -->
        <script>
            {
                // One-off migration from the two-state button's 'darkMode' ('true'/'false') to 'theme' ('light'/'dark', absent = auto).
                const legacy = localStorage.getItem('darkMode');
                if (legacy !== null) {
                    localStorage.setItem('theme', legacy === 'true' ? 'dark' : 'light');
                    localStorage.removeItem('darkMode');
                }
                // Same rule as isDarkModePreferred() in common.js, which isn't loaded yet.
                const choice = localStorage.getItem('theme');
                document.documentElement.classList.toggle('dark-mode', choice === null ? matchMedia('(prefers-color-scheme: dark)').matches : choice === 'dark');
                const themeColor = document.createElement('meta');
                themeColor.name = 'theme-color';
                themeColor.content = getComputedStyle(document.documentElement).getPropertyValue('--background').trim();
                document.head.appendChild(themeColor);
            }
        </script>
    </head>
    <body class="{{ bodyClass }}"{% if scrollspy %} data-spy="scroll" data-target="#ftco-navbar" data-offset="300"{% endif %} onload="{{ onload }}">
        <div id="ftco-loader" class="show" role="status" aria-live="polite" aria-atomic="true" aria-label="{{ common.loading[lang] }}">
            <div class="spinner" aria-hidden="true"></div>
            <span class="sr-only">{{ common.loading[lang] }}</span>
        </div>
        <div id="ftco-visitor" hidden aria-label="{{ landmarkLang.visitor }}"></div>
        {%- if showContact %}
        <div id="contact-icon" class="open-mfp d-flex justify-content-center text-white" role="button" tabindex="0" data-target="#contact-window" aria-expanded="false" aria-controls="contact-window" aria-label="{{ contact.title[lang] }}">
            <span class="icon-user" aria-hidden="true"></span>
        </div>
        <div id="contact-window" class="mfp flex-column bg-white" hidden>
            <div id="contact-header" class="d-flex align-items-center justify-content-between">
                <h6 class="text-white font-weight-bold mt-2">{{ contact.title[lang] }}</h6>
                <span class="mfp-close text-white" aria-label="{{ common.closeLabel[lang] }}">×</span>
            </div>
            <div id="contact-link" class="text-dark">
                <p class="d-flex align-items-center">
                    <i class="icon-envelope"></i>
                    <span class="email"></span>
                </p>
                {%- for s in socials %}
                <p class="d-flex align-items-center">
                    <i class="icon-{{ s.modalIcon or s.icon }}"></i>
                    <a target="_blank" rel="noopener" href="{{ s.href }}" aria-label="{{ s.label }}">{{ s.label }}</a>
                </p>
                {%- endfor %}
            </div>
        </div>
        {%- endif %}
        {%- if showNav %}
        <nav id="ftco-navbar" class="navbar navbar-expand-lg navbar-dark ftco-navbar-light" aria-label="{{ landmarkLang.nav }}">
            {% include "nav.html" %}
        </nav>
        {%- endif %}
        <main id="ftco-main" aria-label="{{ landmarkLang.main }}">
            {{ content | safe }}
        </main>
        <footer id="ftco-footer"{% if standalone %} class="standalone"{% endif %} aria-label="{{ landmarkLang.footer }}">
            {% include "footer.html" %}
        </footer>
    </body>
</html>
