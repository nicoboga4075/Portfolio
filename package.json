  "scripts": {
    "dev": "npm run gen:redirects && node dev-watch.js --once",
    "dev:watch": "npm run gen:redirects && node dev-watch.js",
    "dev:live": "npm run gen:redirects && node dev-watch.js --once --live=dev",
    "dev:live:watch": "npm run gen:redirects && node dev-watch.js --live=dev",
    "adb:devices": "adb devices",
    "adb:reverse": "node adb-reverse.js",
    "adb:unreverse": "node adb-reverse.js --remove",
    "adb:kill": "adb kill-server",
    "build": "npm run gen:redirects && npm run eleventy && npm run uglify:js",
    "gen:redirects": "node gen-redirects.js",
    "kill": "taskkill /IM node.exe /F",
    "tag-version": "bash -c \"version=$(node -p \\\"require('./package.json').version\\\"); if git status --porcelain | grep -vE '^.M (package.json|CHANGELOG.md)' | grep -q .; then echo 'Uncommitted or unstaged changes detected. Please commit or stash your changes before tagging.'; else git tag v$version; echo 'v'$version; fi\" --",
    "changelog": "auto-changelog",
    "rollback-reflog": "bash -c \"git reflog --oneline; echo ''; read -p 'Reflog index to restore (ex: 1, 2, 3...) : ' idx; ref=HEAD@{$idx}; echo 'Rollback vers' $ref; git reset --hard $ref; for tag in $(git tag --contains HEAD@{0}); do git tag -d $tag; git push origin :$tag; done; git push --force\" --",
    "push-all": "bash -c \"if [ \\\"$1\\\" = \\\"force\\\" ]; then git push --force && git push --tags --force; else git push && git push --tags; fi\" --",
    "release": "bash -c \"level=${1:-patch}; if [[ $level == '-h' || $level == '--help' ]]; then echo 'Usage : npm run release -- [patch|minor|major|x.y.z]'; echo 'Exemples :'; echo '  npm run release -> patch (defaut)'; echo '  npm run release -- minor'; echo '  npm run release -- major'; echo '  npm run release -- 2.1.0'; exit 0; fi; if [[ ! $level =~ ^(patch|minor|major|[0-9]+\\.[0-9]+\\.[0-9]+)$ ]]; then echo 'Invalid level: '$level; echo ''; echo 'Usage : npm run release -- [patch|minor|major|x.y.z]'; echo 'Exemples :'; echo '  npm run release -> patch (defaut)'; echo '  npm run release -- minor'; echo '  npm run release -- major'; echo '  npm run release -- 1.0.0'; exit 1; fi; npm version $level --no-git-tag-version > /dev/null; version=$(node -p \\\"require('./package.json').version\\\"); if git tag | grep -q \\\"^v$version$\\\"; then echo 'Tag v'$version' already exists, deleting and recreating...'; git tag -d v$version; git push origin :refs/tags/v$version; fi; git tag v$version; npm run changelog; node update-version.js \\\"$version\\\" || exit 1; git tag -d v$version; git add package.json package-lock.json CHANGELOG.md changelog.hbs update-version.js .github/workflows/node.js.yml; git commit -m 'Release v'$version; git tag v$version; git push && git push --tags; echo 'Released v'$version\" --",
    "netlify:ops": "node .claude/skills/netlify-ops/netlify-ops.mjs",
    "lint": "npm run lint:html & npm run lint:css & npm run lint:js",
    "lint:html": "npx html-validate \"*.html\" \"*/*.html\"",
    "lint:css": "npx stylelint \"**/*.css\"",
    "lint:js": "npx eslint .",
    "deps:audit": "npm audit",
    "deps:audit:fix": "npm audit fix",
    "deps:audit:signatures": "npm audit signatures",
    "deps:install": "npm install",
    "deps:install:ci": "npm ci",
    "hide:folders": "node hide-folders.js",
    "postinstall": "npm run hide:folders",
    "deps:outdated": "npm outdated",
    "deps:updates": "npx --yes npm-check-updates",
    "deps:updates:minor": "npx --yes npm-check-updates --target minor",
    "deps:update": "npm update",
    "deps:why": "npm explain",
    "deps:tree": "npm ls --all --depth=0",
    "deps:prune": "npm prune",
    "usage": "npx --yes ccusage@latest claude daily",
    "usage:weekly": "npx --yes ccusage@latest claude weekly",
    "usage:monthly": "npx --yes ccusage@latest claude monthly",
    "usage:session": "npx --yes ccusage@latest claude session",
    "usage:block": "npx --yes ccusage@latest claude blocks --active",
    "contrast": "node .claude/skills/wcag-contrast/check-contrast.mjs",
    "contrast:quick": "node .claude/skills/wcag-contrast/check-contrast.mjs --quick",
    "check:content": "node .claude/skills/check-content/check-content.mjs",
    "check:docs": "node .claude/skills/update-docs/check-docs.mjs",
    "check:translation": "node .claude/skills/i18n-l10n/check-translation.mjs",
    "check:links": "node .claude/skills/check-links/check-links.mjs",
    "check:overrides": "node .claude/skills/check-overrides/check-overrides.mjs",
    "test": "npm run jest & npm run cypress & npm run playwright & npm run robot",
    "jest": "npx jest --coverage --passWithNoTests",
    "playwright": "playwright test",
    "cypress": "npx cypress run --project tests",
    "robot": "robot --outputdir reports/robot tests/robot",
    "simu:ci": "powershell.exe -Command \"Start-Process powershell.exe -ArgumentList '-NoExit','-Command','Set-Location -LiteralPath \\\"%CD%\\\"; ./.gitlab/simulator_ci.ps1' -Verb RunAs\"",
    "uglify:js": "node uglify-code.js",
    "uglify:preview": "node uglify-code.js .eleventy/js",
    "eleventy": "npx eleventy",
    "capacitor:add": "npx cap add android",
    "capacitor:sync": "npx cap sync",
    "capacitor:open": "npx cap open android",
    "capacitor:run": "npx cap run android"
  },
  "auto-changelog": {
    "commitLimit": false,
    "backfillLimit": false,
    "sortCommits": "date",
    "template": "changelog.hbs",
    "ignoreCommitPattern": "^Release v"
