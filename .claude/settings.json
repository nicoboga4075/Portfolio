{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-before-commit.mjs\"",
            "timeout": 300,
            "statusMessage": "Linting HTML, CSS and JS before the commit..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-reminder-before-commit.mjs\"",
            "timeout": 90,
            "statusMessage": "Asking Claude Haiku whether the committed code has a test..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/start-translation-hook-server.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:4799/post-edit",
            "timeout": 10,
            "statusMessage": "Checking the translations of the edited data file..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "portfolio-dev@portfolio": true
  },
  "extraKnownMarketplaces": {
    "portfolio": {
      "source": {
        "source": "directory",
        "path": "./.claude/marketplace"
      }
    }
  }
}
